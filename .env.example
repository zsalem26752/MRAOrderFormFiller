# ============================================================
#  Order Form Filler Agent — Environment Variables
#  Copy this file to .env and fill in your values.
# ============================================================


# ── ClickUp ──────────────────────────────────────────────────
CLICKUP_API_KEY=pk_...
CLICKUP_LIST_ID=...
TRIGGER_STATUS=GIVEN TO JAY
NEXT_STATUS=Sent to Zack


# ── Sunesta form templates (blank PDFs) ──────────────────────
# Defaults to ./sunesta_forms/ (bundled in repo). Override if needed.
# SUNESTA_FORMS_FOLDER=/path/to/sunesta/forms


# ── Output folder (filled PDFs saved here) ───────────────────
# Used only when DROPBOX_ACCESS_TOKEN is NOT set (local dev mode).
# Defaults to ./output/. Override to point at your local Dropbox-synced folder.
# FILLED_FORMS_FOLDER=/path/to/local/output


# ── Dropbox (Railway / cloud deployment) ─────────────────────
# Set DROPBOX_ACCESS_TOKEN to enable Dropbox storage.
# When set, filled PDFs are uploaded to Dropbox instead of local disk.
# Leave unset for local dev (uses FILLED_FORMS_FOLDER above).
# DROPBOX_ACCESS_TOKEN=sl.xxxxxxxx...
# DROPBOX_FOLDER=/MRA Order Forms


# ── Zoho Invoice ─────────────────────────────────────────────
ZOHO_CLIENT_ID=1000....
ZOHO_CLIENT_SECRET=...
ZOHO_REFRESH_TOKEN=1000....
ZOHO_ORGANIZATION_ID=...
ZOHO_REGION=com


# ── Anthropic ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...


# ── Slack ────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
SLACK_CHANNEL=order-verifications


# ── Scheduler ────────────────────────────────────────────────
TIMEZONE=America/New_York

# ── Railway-specific ─────────────────────────────────────────
# Set AUTO_SCHEDULER=1 to run the cron scheduler inside the web process.
# Required on Railway (no separate worker dyno).
AUTO_SCHEDULER=1

# ============================================================
#  Order Form Filler Agent — Environment Variables
#  Copy this file to .env and fill in your values.
# ============================================================


# ── ClickUp ──────────────────────────────────────────────────
CLICKUP_API_KEY=pk_...
CLICKUP_LIST_ID=...
TRIGGER_STATUS=GIVEN TO JAY
NEXT_STATUS=Sent to Zack


# ── Sunesta form templates (blank PDFs) ──────────────────────
# Defaults to ./sunesta_forms/ (bundled in repo). Override if needed.
# SUNESTA_FORMS_FOLDER=/path/to/sunesta/forms


# ── Output folder (filled PDFs saved here — local dev only) ──
# On Railway, Dropbox is used instead (see below).
# Locally, set this to your Dropbox-synced output folder.
# Defaults to ./output/ if neither this nor DROPBOX_FOLDER is set.
FILLED_FORMS_FOLDER=/Users/yourname/Mr Awnings Dropbox/Mr Awnings/01.01 - SUNESTA/03.00 - 2026 ORDERS/2026 FILLED FORMS


# ── Dropbox (OAuth2 — shared with Order Verifier on Railway) ─
# These three vars are set once in the Railway project and shared
# by both the Order Form Filler and the Order Verifier agents.
# Leave blank for local dev — files will be saved to FILLED_FORMS_FOLDER.
DROPBOX_APP_KEY=...
DROPBOX_APP_SECRET=...
DROPBOX_REFRESH_TOKEN=1000....

# Root of the local Dropbox folder (strips this prefix when building API paths).
# Only needed locally when DROPBOX_REFRESH_TOKEN is set and paths are local.
DROPBOX_LOCAL_ROOT=/Users/yourname/Mr Awnings Dropbox

# The Dropbox folder where filled PDFs are saved.
# Locally: full path  →  /Users/yourname/Mr Awnings Dropbox/Mr Awnings/.../2026 FILLED FORMS
# Railway: API path   →  /Mr Awnings/01.01 - SUNESTA/03.00 - 2026 ORDERS/2026 FILLED FORMS
DROPBOX_FOLDER=/Mr Awnings/01.01 - SUNESTA/03.00 - 2026 ORDERS/2026 FILLED FORMS


# ── Zoho Invoice ─────────────────────────────────────────────
ZOHO_CLIENT_ID=1000....
ZOHO_CLIENT_SECRET=...
ZOHO_REFRESH_TOKEN=1000....
ZOHO_ORGANIZATION_ID=...
ZOHO_REGION=com


# ── Anthropic ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...


# ── Slack ────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
SLACK_CHANNEL=order-verifications


# ── Scheduler ────────────────────────────────────────────────
TIMEZONE=America/New_York

# ── Railway-specific ─────────────────────────────────────────
# Set AUTO_SCHEDULER=1 to run the cron scheduler inside the web process.
# Required on Railway (no separate worker dyno).
AUTO_SCHEDULER=1
